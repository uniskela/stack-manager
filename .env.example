# stack-manager configuration. Copy to .env (never commit .env).
# Keep the encryption key and session secret in your host's secret management and back them up
# separately from the data volume: losing the encryption key makes stored credentials unrecoverable.

# --- Required ---------------------------------------------------------------

# 32 random bytes, base64. Generate: openssl rand -base64 32
STACK_MANAGER_ENCRYPTION_KEY=
# At least 32 random characters. Generate: openssl rand -base64 48
STACK_MANAGER_SESSION_SECRET=
# Persistent directory for SQLite and Git clones. docker-compose.yml sets this to /data (a named volume).
STACK_MANAGER_DATA_DIR=./data

# --- Optional ---------------------------------------------------------------

# Bump when rotating the encryption key (re-encryption job is planned; see docs/AUTH_AND_CREDENTIALS.md).
STACK_MANAGER_ENCRYPTION_KEY_VERSION=1
# Public origin when running behind a reverse proxy, e.g. https://stacks.example.com (used for CSRF origin checks).
STACK_MANAGER_PUBLIC_URL=
# Secure cookies default to true in production. Set false ONLY for plain-HTTP local testing.
STACK_MANAGER_COOKIE_SECURE=true
# If set (16+ chars), first-run admin setup requires this token. Recommended when the instance is reachable before setup.
STACK_MANAGER_SETUP_TOKEN=
# Allow Git remotes on private networks (RFC 1918, CGNAT, IPv6 ULA), e.g. a homelab Gitea/Forgejo.
# Loopback, link-local and cloud-metadata addresses are always blocked.
STACK_MANAGER_ALLOW_PRIVATE_NETWORKS=false
# debug | info | warn | error
STACK_MANAGER_LOG_LEVEL=info
# Session lifetime in hours (sliding). Default 168 (7 days).
STACK_MANAGER_SESSION_TTL_HOURS=168
# Number of trusted reverse proxies in front of stack-manager. 0 (default) ignores X-Forwarded-For /
# X-Real-IP entirely, since clients can forge them. Set to 1 behind a single proxy that appends the client
# address to X-Forwarded-For. Only used to key login/setup rate limits.
STACK_MANAGER_TRUSTED_PROXY_HOPS=0
# Host interface and port published by docker-compose.yml. Localhost by default; front it with a reverse proxy,
# or set STACK_MANAGER_BIND=0.0.0.0 to expose it on all interfaces.
STACK_MANAGER_BIND=127.0.0.1
STACK_MANAGER_PORT=3000
